PORT=3000
# Rede interna atrás do Caddy/IIS na mesma máquina: HOST=127.0.0.1 e TRUST_PROXY=loopback
# (no Render deixe os dois vazios). Ver docs/IMPLANTACAO-WINDOWS.md
HOST=
TRUST_PROXY=
IXC_HOST=http://localhost:4000
IXC_USER_ID=seu_user_id
IXC_TOKEN=seu_token_ixc
SENHA_N2=sua_senha_n2
JWT_SECRET=seu_segredo_jwt_seguro
JWT_EXPIRES_IN=12h
SENHA_OPERADOR=sua_senha_de_operador

# Consulta PPPoE no concentrador Huawei (SSH) — use um usuário SOMENTE LEITURA
PPPOE_SSH_HOST=concentrador.exemplo.com.br
PPPOE_SSH_PORT=22
PPPOE_SSH_USER=usuario_somente_leitura
PPPOE_SSH_PASS=sua_senha_ssh
# Opcional: fixa a chave do host (saída do `ssh-keygen -lf`), ex.: SHA256:AbC123...
PPPOE_SSH_HOST_FINGERPRINT=
PPPOE_SSH_TIMEOUT_MS=15000
# Senha que libera a consulta PPPoE nas telas (só quem tiver esta senha consulta; N2 também pode)
SENHA_PPPOE=sua_senha_consulta_pppoe
# Validade do acesso liberado pela SENHA_PPPOE (trocar a senha derruba todos os acessos na hora)
PPPOE_TOKEN_EXPIRES_IN=8h
# Máximo de sessões SSH simultâneas no concentrador (somando todos os usuários)
PPPOE_MAX_SIMULTANEAS=2
